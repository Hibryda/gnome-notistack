# systemd user unit for the gnome-notistack daemon.
# Type=dbus: readiness is signalled by BusName appearance (no sd_notify needed).
# ExecStopPost survives even SIGKILL, so a crash restores the shell's own
# notification proxy by removing the blocking overrides + reloading systemd.
[Unit]
Description=gnome-notistack notification daemon
Documentation=https://git.hemoglobina.store/hibryda/gnome-notistack
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.Notifications
ExecStart=/usr/lib/gnome-notistack/gnome-notistack
ExecStopPost=/bin/sh -c 'rm -f "%h/.config/systemd/user/org.gnome.Shell.Notifications.service.d/override.conf" "%h/.local/share/dbus-1/services/org.gnome.Shell.Notifications.service"; systemctl --user daemon-reload'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
