# systemd user unit for the gnome-notistack daemon.
#
# Long-running, queued model: the daemon starts at login, requests both
# notification names (REPLACE_EXISTING only → InQueue), and waits. The companion
# extension then frees the names (SIGTERM the gjs proxy + ReleaseName the GTK
# name) and D-Bus promotes the queued daemon. Starting the daemon BEFORE the
# extension's (deferred, daemon-ready-gated) takeover is what makes login safe —
# the extension never frees a name with no claimant.
#
# Not Type=dbus (the name isn't owned until takeover) and not D-Bus-activated;
# no /bin/false override is used, so there is nothing to clean up on stop.
[Unit]
Description=gnome-notistack notification daemon
Documentation=https://git.hemoglobina.store/hibryda/gnome-notistack
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Find our GSettings schema (shipped with the extension).
Environment=GSETTINGS_SCHEMA_DIR=/usr/share/gnome-shell/extensions/notistack@hemoglobina.store/schemas
# Wait until the session has imported DISPLAY into the user manager environment,
# so ExecStart inherits it and the render thread can reach X11. Without this the
# daemon can start before DISPLAY exists, the render thread fails to connect, and
# every notification is silently dropped. (ExecStart inherits the manager env as
# of fork time, so the wait must finish first.) Proceeds anyway after ~9s.
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do systemctl --user show-environment | grep -q "^DISPLAY=" && exit 0; sleep 0.3; done; exit 0'
ExecStart=/usr/lib/gnome-notistack/gnome-notistack
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
